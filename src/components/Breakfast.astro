---
import { breakfastItems, images } from '../config/site';
---

<section id="breakfast" class="bg-base-200 py-10 sm:py-12">
  <div class="container mx-auto px-4">
    <div class="reveal card bg-base-100 shadow-lg lg:card-side">
      <figure class="shrink-0 overflow-hidden lg:w-[34%] xl:w-[30%]">
        <img
          src={images.kidsBreakfast}
          alt="Young girl enjoying free breakfast at the Energy Expo"
          class="img-kids-face aspect-[4/3] w-full object-cover object-[38%_45%] lg:max-h-72"
          width="600"
          height="450"
          loading="lazy"
        />
      </figure>
      <div class="card-body gap-2 p-5 sm:p-6 lg:justify-start">
        <div class="badge badge-secondary badge-sm font-bold uppercase">Complimentary</div>
        <h2 class="card-title text-2xl font-extrabold uppercase tracking-tight text-primary sm:text-3xl">
          <span class="text-secondary">Free</span> Breakfast
        </h2>
        <p class="text-base text-base-content/70">
          Start your morning with a complimentary breakfast including:
        </p>
        <ul class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-2.5" role="list">
          {
            breakfastItems.map((item) => (
              <li class="flex items-center gap-2.5 rounded-lg bg-base-200 px-4 py-3 text-base font-semibold text-primary sm:text-lg">
                <span class="text-lg text-secondary" aria-hidden="true">✓</span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
