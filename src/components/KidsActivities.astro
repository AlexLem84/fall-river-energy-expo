---
import { images, kidsActivities } from '../config/site';
---

<section id="kids" class="container mx-auto px-4 py-10 sm:py-12">
  <div class="reveal card overflow-hidden bg-base-100 shadow-lg lg:flex lg:flex-row lg:items-center lg:gap-0">
    <div class="card-body gap-2 p-5 sm:p-6 lg:flex-1 lg:justify-start">
      <div class="badge badge-primary badge-outline badge-sm font-bold uppercase">Family Friendly</div>
      <h2 class="card-title text-2xl font-extrabold uppercase tracking-tight text-primary sm:text-3xl">
        Bring the Kids!
      </h2>
      <p class="text-base text-base-content/70">Lots of kids activities including:</p>
      <ul class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-2.5" role="list">
        {
          kidsActivities.map((activity) => (
            <li class="flex items-start gap-2.5 rounded-lg bg-base-200 px-4 py-3 text-base font-semibold text-primary sm:text-lg">
              <span class="mt-0.5 text-lg text-secondary" aria-hidden="true">★</span>
              <span>{activity}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="shrink-0 bg-base-200/60 p-3 sm:p-4 lg:w-[32%] xl:w-[28%]">
      <div class="img-climbing mx-auto w-full max-w-[10rem] sm:max-w-44 lg:max-h-72 lg:max-w-none">
        <img
          src={images.climbingWall}
          alt="Girl smiling on the climbing wall at the Energy Expo"
          class="size-full"
          width="600"
          height="800"
          loading="lazy"
        />
      </div>
    </figure>
  </div>
</section>
